{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "metadata": {
    "workspace_name": "UAV Software Integration Workspace",
    "task_order": "TASK ORDER 3",
    "assigned_engineer": "Lakshay Thakur (TRAIN-004)",
    "role": "Systems Integration Engineer \u2014 UAV Training Assignment",
    "deliverable_id": "L06_Integration_Configuration.json",
    "configuration_version": "1.2.0",
    "effective_date": "2026-10-24",
    "environment": "development_local_sitl",
    "active_profile": "sitl_nominal_loiter"
  },
  "global_network_and_transports": {
    "loopback_host": "127.0.0.1",
    "broadcast_enabled": false,
    "transports": {
      "mavlink_gcs_downlink": {
        "protocol": "udp",
        "bind_address": "127.0.0.1",
        "port": 14550,
        "description": "Bidirectional MAVLink telemetry connection to Ground Control Station (QGroundControl / Mission Planner)"
      },
      "synthetic_sensor_stimulus": {
        "protocol": "udp",
        "bind_address": "127.0.0.1",
        "port": 14555,
        "description": "High-rate synthetic sensor stream input (IMU, GNSS, Barometer) from M03 (SDG) to M04 (IAG)"
      },
      "telemetry_audit_stream": {
        "protocol": "udp",
        "bind_address": "127.0.0.1",
        "port": 14560,
        "description": "Flight trace and audit telemetry stream from M04/M05/M06 to M07 (IVR)"
      },
      "rest_health_probe": {
        "protocol": "http",
        "bind_address": "127.0.0.1",
        "port": 8088,
        "description": "Local HTTP diagnostic and readiness probe endpoint"
      }
    }
  },
  "protocol_contracts": {
    "mavlink": {
      "version": 2,
      "dialect": "common",
      "schema_path": "config/mavlink_dialects/common_v2.json",
      "system_id": 1,
      "component_id": 1,
      "heartbeat_interval_hz": 1.0,
      "enforce_crc_extra": true
    },
    "posix_realtime_buffers": {
      "queue_capacity_frames": 1024,
      "overflow_policy": "drop_oldest",
      "memory_locked": false
    }
  },
  "modules": {
    "m01_icr": {
      "module_name": "UAV Interface & Telemetry Schema Registry",
      "module_code": "ICR",
      "enabled": true,
      "strict_schema_enforcement": true,
      "schema_repository_path": "config/mavlink_dialects",
      "supported_message_ids": [
        0,
        1,
        30,
        33,
        74,
        253
      ],
      "units": {
        "attitude": "radians",
        "angular_velocity": "rad/s",
        "linear_acceleration": "m/s^2",
        "coordinates": "degE7",
        "altitude": "millimeters",
        "velocity": "cm/s"
      }
    },
    "m02_dsc": {
      "module_name": "Flight Readiness & Dependency Coordinator",
      "module_code": "DSC",
      "enabled": true,
      "startup_dependency_order": [
        "m01_icr",
        "m06_psa",
        "m05_cpe",
        "m04_iag",
        "m03_sdg",
        "m07_ivr"
      ],
      "readiness_timeout_seconds": 5.0,
      "pre_arm_safety_checks": {
        "require_ekf_healthy": true,
        "require_gps_3d_fix": true,
        "min_satellites_visible": 10,
        "max_hdop": 1.2,
        "min_battery_voltage_volts": 14.8,
        "require_rc_failsafe_valid": true,
        "require_geofence_present": true
      }
    },
    "m03_sdg": {
      "module_name": "Synthetic Flight & Sensor Data Generator",
      "module_code": "SDG",
      "enabled": true,
      "random_seed": 42,
      "stream_rates_hz": {
        "imu_raw": 100,
        "gnss_pos": 10,
        "barometer": 20,
        "battery_status": 2
      },
      "sensor_noise_profile": {
        "gyro_noise_std_rad_s": 0.005,
        "accel_noise_std_m_s2": 0.02,
        "gps_lat_lon_std_m": 0.5,
        "baro_alt_std_m": 0.15
      },
      "fault_injection": {
        "enable_fault_profiles": false,
        "fault_types": [
          "gps_denial",
          "barometer_stuck",
          "battery_sag",
          "packet_crc_corruption"
        ]
      }
    },
    "m04_iag": {
      "module_name": "Telemetry Ingestion & MAVLink Gateway",
      "module_code": "IAG",
      "enabled": true,
      "max_ingest_rate_packets_per_second": 1000,
      "packet_validation": {
        "verify_crc": true,
        "verify_sequence_continuity": true,
        "drop_out_of_order": false,
        "quarantine_corrupted_packets": true
      },
      "quarantine_buffer_limit": 256
    },
    "m05_cpe": {
      "module_name": "GNC & Mission Processing Engine",
      "module_code": "CPE",
      "enabled": true,
      "flight_limits": {
        "max_altitude_meters_agl": 120.0,
        "max_horizontal_speed_m_s": 15.0,
        "max_climb_rate_m_s": 4.0,
        "max_descent_rate_m_s": 2.5,
        "max_tilt_angle_degrees": 35.0
      },
      "failsafe_rules": {
        "on_link_loss_timeout_seconds": 3.0,
        "on_link_loss_action": "RTL",
        "on_low_battery_voltage_volts": 14.2,
        "on_low_battery_action": "RTL",
        "on_critical_battery_voltage_volts": 13.6,
        "on_critical_battery_action": "LAND",
        "on_geofence_breach_action": "RTL"
      },
      "geofence": {
        "type": "cylinder",
        "center_latitude_deg": 32.219,
        "center_longitude_deg": 76.3234,
        "radius_meters": 500.0,
        "floor_altitude_meters": 0.0,
        "ceiling_altitude_meters": 120.0
      }
    },
    "m06_psa": {
      "module_name": "Flight Data Logger & GCS Adapter",
      "module_code": "PSA",
      "enabled": true,
      "storage_backend": "sqlite",
      "database_file": "data/flight_logs/sitl_flight_records.db",
      "flight_telemetry_tlog": "data/flight_logs/flight_telemetry.tlog",
      "flush_interval_seconds": 1.0,
      "gcs_downlink_enabled": true,
      "retention_days": 30
    },
    "m07_ivr": {
      "module_name": "UAV Integration Verification & Check Runner",
      "module_code": "IVR",
      "enabled": true,
      "scenario_suite_path": "config/test_profiles",
      "assertion_tolerances": {
        "max_mode_switch_latency_ms": 50.0,
        "max_telemetry_jitter_ms": 15.0,
        "max_ekf_pos_drift_meters": 1.0,
        "max_packet_loss_allowed_percent": 0.0
      },
      "output_report_format": "markdown",
      "report_destination_dir": "logs"
    }
  },
  "logging": {
    "level": "DEBUG",
    "console_output": true,
    "log_directory": "logs",
    "master_log_file": "logs/integration_workspace.log",
    "max_log_size_bytes": 10485760,
    "backup_count": 5,
    "structured_json_logging": false
  }
}